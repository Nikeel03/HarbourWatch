# Local reference only. Do not put the real API key in worker.js or index.html.
#
# Copy this file to .env, then replace the placeholder after the equals sign:
AISSTREAM_API_KEY=PASTE_YOUR_AISSTREAM_IO_API_KEY_HERE

# Cloudflare Workers does not automatically load this file as a Worker secret.
# From the HarbourWatch folder, set the real secret with:
#   npx wrangler secret put AISSTREAM_API_KEY
# Wrangler will prompt you securely for the value above.
